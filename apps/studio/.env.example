# Provision Neon and Clerk through the Vercel Marketplace, then run:
# vercel env pull apps/studio/.env.local
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI Gateway and Vercel Queues use Vercel OIDC in deployed environments.
# For local development, `vercel env pull` supplies a short-lived token.
VERCEL_OIDC_TOKEN=
VERCEL_QUEUE_API_TOKEN=
CRON_SECRET=
FABRIC_MODEL=

# Cloud provider adapter. Deployed Fabric uses its linked Vercel project and
# OIDC by default. These values support explicit local/CI credentials.
VERCEL_TOKEN=
# Optional after `vercel link`; Fabric also reads .vercel/project.json locally.
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_PREFIX=fabric
# Local development runs cloud operations inline. Production defaults to queues.
FABRIC_CLOUD_EXECUTION_MODE=inline
VERCEL_SANDBOX_IMAGE_NODE=
VERCEL_SANDBOX_IMAGE_PYTHON=
VERCEL_SANDBOX_IMAGE_GO=

# Optional workspace notification adapter. Apps keep using the abstract
# `notifications.send` capability; the host routes it to Slack.
SLACK_WEBHOOK_URL=
