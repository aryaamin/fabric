# Provision Neon and Clerk through the Vercel Marketplace, then run:
# vercel env pull apps/studio/.env.local
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI Gateway and Vercel Queues use Vercel OIDC in deployed environments.
# For local development, `vercel env pull` supplies a short-lived token.
VERCEL_OIDC_TOKEN=
VERCEL_QUEUE_API_TOKEN=
CRON_SECRET=
FABRIC_MODEL=

# Optional workspace notification adapter. Apps keep using the abstract
# `notifications.send` capability; the host routes it to Slack.
SLACK_WEBHOOK_URL=
